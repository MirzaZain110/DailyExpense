{
  "expo": {
    "name": "DailyExpense",
    "slug": "daily-expense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/Icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#4C6FFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.dailyexpense"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Icon.jpg",
        "backgroundColor": "#4C6FFF"
      },
      "package": "com.zainulabdin.dailyexpense"
    },
    "web": {
      "favicon": "./src/assets/Icon.jpg"
    }
  }
}